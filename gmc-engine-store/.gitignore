# next.js build output
# Tracking these caused Windows EPERM/UNKNOWN(-4094) crashes in `next dev`:
# git + the editor's git extension hold handles on chunk files while Next
# tries to atomically rename them, which Windows rejects as a sharing violation.
.next/
out/
build/
dist/

